<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles the Unity EditMode test sources at exactly the language and API
    level Unity has: C# 9 and netstandard2.1. Nothing runs here — the point is
    that a file which compiles under these settings will compile inside Unity,
    which is otherwise only discoverable on a machine with the editor installed.

    A build failure here means the smoke tests use something Unity's compiler
    or its API surface does not have.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>FiveDSudoku.UnityCompileCheck</AssemblyName>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- NUnit 3, which is what Unity's Test Framework ships. -->
    <PackageReference Include="NUnit" Version="3.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The very files Unity compiles, linked rather than copied. -->
    <Compile Include="..\..\FiveDSudoku\Assets\FiveDSudoku\Tests\EditMode\CoreSmokeTests.cs"
             Link="CoreSmokeTests.cs" />
  </ItemGroup>

</Project>
